{
  "name": "@k2b/sync",
  "version": "5.7.0",
  "description": "Distributed sync primitives for TypeScript and Bun \u2014 ratelimit, mutex, queue, topic, job, pump, scheduler, ephemeral, retry",
  "module": "index.ts",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./browser": "./browser.ts"
  },
  "scripts": {
    "test": "REDIS_URL=redis://127.0.0.1:6399 bun test --preload ./tests/preload.ts",
    "test:fault": "REDIS_URL=redis://127.0.0.1:6399 bun test --preload ./tests/preload.ts tests/fault-*.test.ts",
    "test:all": "REDIS_URL=redis://127.0.0.1:6399 bun test --preload ./tests/preload.ts tests/*.test.ts",
    "typecheck": "bunx tsc --noEmit",
    "test:v6": "bun test --preload ./tests/v6/preload.ts tests/v6/*.test.ts",
    "test:v6:serial": "bun test --preload ./tests/v6/preload.ts tests/v6/serial/fault.test.ts && bun test --preload ./tests/v6/preload.ts tests/v6/serial/probe.test.ts"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/kv": "3.4.0",
    "@nats-io/nats-core": "3.4.0",
    "@nats-io/obj": "3.4.0"
  },
  "devDependencies": {
    "@nats-io/transport-node": "3.4.0"
  }
}
